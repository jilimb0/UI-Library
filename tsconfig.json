{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@ui-construction-library/core": [
        "packages/core/src/index.ts"
      ],
      "@ui-construction-library/utils": [
        "packages/utils/src/index.ts"
      ],
      "@ui-construction-library/tokens": [
        "packages/tokens/src/index.ts"
      ],
      "@ui-construction-library/icons": [
        "packages/icons/src/index.ts"
      ],
      "@ui-construction-library/primitives": [
        "packages/primitives/src/index.ts"
      ],
      "@ui-construction-library/schema": [
        "packages/schema/src/index.ts"
      ],
      "@ui-construction-library/registry": [
        "packages/registry/src/index.ts"
      ],
      "@ui-construction-library/styles": [
        "packages/styles/src/index.ts"
      ],
      "@ui-construction-library/react-hook-form": [
        "packages/integrations/react-hook-form/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/core/src",
    "packages/integrations/react-hook-form/src",
    "packages/utils/src",
    "packages/tokens/src",
    "vitest.config.ts",
    "vitest.setup.ts",
    "apps/builder/**/*",
    "apps/demo-showcase/**/*",
    "apps/docs/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
