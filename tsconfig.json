{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "packages/core/src",
    "packages/integrations/react-hook-form/src",
    "packages/utils/src",
    "packages/tokens/src",
    "vitest.config.ts",
    "vitest.setup.ts",
    "apps/builder/**/*",
    "apps/demo-showcase/**/*",
    "apps/docs/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
