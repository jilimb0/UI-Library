# Example environment variables
# Copy this file to .env.local and populate the values for your environment.

# App runtime
NODE_ENV=development

# Builder base paths
BUILDER_BASE_PATH=/builder/
DEMO_BASE_PATH=/demo/
DOCS_BASE_PATH=/docs/
STORYBOOK_BASE_PATH=/storybook/

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Visual regression / release automation
CHROMATIC_PROJECT_TOKEN=

# Generic application secret placeholder
API_KEY=
