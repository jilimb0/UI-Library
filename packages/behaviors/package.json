{
  "name": "@ui-construction-library/behaviors",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.json --emitDeclarationOnly --declarationMap",
    "test": "vitest run --config ./vitest.config.ts src",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.34.8",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "type": "module",
  "description": "Framework-agnostic behavior layer for @ui-construction-library \u2014 pure JS state machines, ARIA attributes, and interaction logic.",
  "keywords": [
    "behaviors",
    "state-machine",
    "aria",
    "accessibility",
    "design-system",
    "framework-agnostic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jilimb0/UI-Library.git",
    "directory": "packages/behaviors"
  },
  "homepage": "https://github.com/jilimb0/UI-Library#readme"
}
