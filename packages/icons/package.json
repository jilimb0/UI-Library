{
  "name": "@ui-construction-library/icons",
  "version": "0.6.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm build:icons && rollup -c",
    "build:icons": "node scripts/build-icons.js",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@testing-library/react": "^16.3.2",
    "happy-dom": "^20.8.9",
    "rollup": "^4.34.8",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "type": "module",
  "description": "Standalone React icon package for @ui-construction-library — tree-shakeable SVG icon components.",
  "keywords": [
    "icons",
    "svg",
    "react",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jilimb0/UI-Library.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/jilimb0/UI-Library#readme"
}
