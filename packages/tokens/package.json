{
  "name": "@ui-construction-library/tokens",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/src/index.d.ts",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./tailwind.preset": {
      "default": "./tailwind.preset.ts"
    },
    "./css": "./dist/tokens.css",
    "./json": "./dist/tokens.raw.json",
    "./semantic": "./dist/tokens.semantic.json",
    "./component": "./dist/tokens.component.json"
  },
  "files": [
    "dist",
    "tailwind.preset.ts",
    "README.md",
    "scripts"
  ],
  "scripts": {
    "build": "rollup -c && node scripts/build-tokens.js",
    "build:tokens": "node scripts/build-tokens.js",
    "test": "vitest run --config ./vitest.config.ts src",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.34.8",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "type": "module",
  "description": "Design token and theme contract for @ui-construction-library \u2014 colors, typography, spacing and CSS variables.",
  "keywords": [
    "design-tokens",
    "css-variables",
    "theme",
    "tailwind",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jilimb0/UI-Library.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/jilimb0/UI-Library#readme"
}
