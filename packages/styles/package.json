{
  "name": "@ui-construction-library/styles",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": [
    "dist/*.css",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run --config ../../vitest.config.ts src",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.34.8",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  },
  "description": "Internal CSS/styles build layer for @ui-construction-library — not for direct consumer use.",
  "ui-construction": {
    "surface": "internal",
    "mode": "library"
  },
  "keywords": [
    "internal",
    "tooling"
  ]
}
