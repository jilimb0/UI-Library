{
  "name": "@ui-construction-library/primitives",
  "version": "0.5.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@ui-construction-library/behaviors": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "happy-dom": "^20.8.9",
    "jest-axe": "^10.0.0",
    "@types/jest-axe": "^3.5.9",
    "rollup": "^4.34.8",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "type": "module",
  "description": "Headless overlay primitives for @ui-construction-library — Dialog, Popover, ContextMenu, Accordion, Tabs, Slider, Switch.",
  "keywords": [
    "headless",
    "primitives",
    "dialog",
    "popover",
    "accessible",
    "react",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jilimb0/UI-Library.git",
    "directory": "packages/primitives"
  },
  "homepage": "https://github.com/jilimb0/UI-Library#readme"
}
