/* Interactive primitives — work without Tailwind when these classes are applied */

.button, .ucl-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.375rem;
  min-height: 2.25rem;
  padding: 0.5rem 1rem;
  border-radius: var(--radius, 2px);
  border: 1px solid transparent;
  font-size: 0.875rem;
  font-weight: 500;
  line-height: 1.25rem;
  white-space: nowrap;
  cursor: pointer;
  transition:
    background-color 0.15s ease,
    border-color 0.15s ease,
    color 0.15s ease,
    box-shadow 0.15s ease,
    opacity 0.15s ease;
}

.button, .ucl-button:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

.button, .ucl-button:disabled {
  opacity: 0.5;
  pointer-events: none;
  cursor: not-allowed;
}

.button--sm, .ucl-button--sm {
  min-height: 2rem;
  padding: 0.375rem 0.75rem;
  font-size: 0.75rem;
}

.button--lg, .ucl-button--lg {
  min-height: 2.5rem;
  padding: 0.625rem 1.5rem;
}

.button--icon, .ucl-button--icon {
  min-height: 2.25rem;
  width: 2.25rem;
  padding: 0.5rem;
}

.button--default, .ucl-button--default {
  background-color: var(--primary);
  color: var(--primary-foreground);
  box-shadow: var(--shadow-sm);
}

.button--default, .ucl-button--default:hover {
  opacity: 0.9;
}

.button--destructive, .ucl-button--destructive {
  background-color: var(--error);
  color: var(--error-foreground);
}

.button--destructive, .ucl-button--destructive:hover {
  opacity: 0.9;
}

.button--outline, .ucl-button--outline {
  background-color: var(--background);
  color: var(--foreground);
  border-color: var(--input);
}

.button--outline, .ucl-button--outline:hover {
  background-color: var(--accent);
  border-color: var(--border);
}

.button--secondary, .ucl-button--secondary {
  background-color: var(--muted);
  color: var(--foreground);
  border-color: var(--border);
}

.button--secondary, .ucl-button--secondary:hover {
  background-color: var(--accent);
}

.button--ghost, .ucl-button--ghost {
  background-color: transparent;
  color: var(--foreground);
}

.button--ghost, .ucl-button--ghost:hover {
  background-color: var(--accent);
}

.button--link, .ucl-button--link {
  min-height: auto;
  padding: 0;
  background: transparent;
  color: var(--foreground);
  text-decoration: underline;
  text-underline-offset: 4px;
}

.button--link, .ucl-button--link:hover {
  color: var(--primary);
}

.button__spinner, .ucl-button__spinner {
  display: inline-block;
  width: 1em;
  height: 1em;
  margin-right: 0.375rem;
  border: 2px solid currentColor;
  border-top-color: transparent;
  border-radius: 9999px;
  animation: button-spin 0.6s linear infinite;
}

@keyframes button-spin {
  to { transform: rotate(360deg); }
}

.button__icon, .ucl-button__icon {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
}

.input, .ucl-input,
.select, .ucl-select,
.textarea, .ucl-textarea {
  width: 100%;
  border-radius: var(--radius, 2px);
  border: 1px solid var(--input);
  background-color: var(--background);
  color: var(--foreground);
  padding: 0.5rem 0.75rem;
  font-size: 0.875rem;
  line-height: 1.25rem;
  transition:
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

.input, .ucl-input {
  min-height: 2.25rem;
}

.select, .ucl-select {
  min-height: 2.25rem;
  padding-right: 2rem;
  appearance: none;
}

.textarea, .ucl-textarea {
  min-height: 5rem;
  resize: vertical;
}

.input--sm, .ucl-input--sm,
.select--sm, .ucl-select--sm {
  min-height: 2rem;
  padding: 0.375rem 0.5rem;
  font-size: 0.75rem;
}

.input--lg, .ucl-input--lg,
.select--lg, .ucl-select--lg {
  min-height: 2.5rem;
  padding: 0.625rem 1rem;
}

.input--error, .ucl-input--error,
.select--error, .ucl-select--error,
.textarea--error, .ucl-textarea--error {
  border-color: var(--error);
}

.input, .ucl-input::placeholder,
.textarea, .ucl-textarea::placeholder {
  color: var(--muted-foreground);
}

.input, .ucl-input:focus,
.select, .ucl-select:focus,
.textarea, .ucl-textarea:focus {
  outline: none;
  border-color: var(--ring);
  box-shadow: 0 0 0 1px var(--ring);
}

.input, .ucl-input:disabled,
.select, .ucl-select:disabled,
.textarea, .ucl-textarea:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.ucl-card {
  border-radius: calc(var(--radius, 2px) + 2px);
  border: 1px solid var(--border);
  background-color: var(--card);
  color: var(--card-foreground);
  box-shadow: var(--shadow-sm);
  padding: 1.5rem;
}

.ucl-badge {
  display: inline-flex;
  align-items: center;
  border-radius: var(--radius, 2px);
  padding: 0.125rem 0.5rem;
  font-size: 0.75rem;
  font-weight: 500;
  line-height: 1rem;
  border: 1px solid transparent;
}

.ucl-badge--default {
  background-color: var(--muted);
  color: var(--foreground);
  border-color: var(--border);
}

.ucl-badge--success {
  background-color: color-mix(in srgb, var(--success) 8%, transparent);
  color: var(--success);
  border-color: color-mix(in srgb, var(--success) 20%, transparent);
}

.ucl-badge--warning {
  background-color: color-mix(in srgb, var(--warning) 8%, transparent);
  color: var(--warning);
  border-color: color-mix(in srgb, var(--warning) 20%, transparent);
}

.ucl-badge--error {
  background-color: color-mix(in srgb, var(--error) 8%, transparent);
  color: var(--error);
  border-color: color-mix(in srgb, var(--error) 20%, transparent);
}

.ucl-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  border-radius: var(--radius, 2px);
  padding: 0.125rem 0.5rem;
  font-size: 0.75rem;
  font-weight: 500;
  line-height: 1rem;
  border: 1px solid var(--border);
  background-color: var(--muted);
  color: var(--foreground);
}

.ucl-tag--sm {
  padding: 0.0625rem 0.375rem;
  font-size: 0.6875rem;
}

.ucl-tag--lg {
  padding: 0.25rem 0.625rem;
  font-size: 0.875rem;
}

.ucl-alert {
  border-radius: var(--radius, 2px);
  border: 1px solid var(--border);
  padding: 0.75rem 1.25rem;
  font-size: 0.875rem;
  line-height: 1.5;
  background-color: var(--background);
  color: var(--foreground);
}

.ucl-alert--default {
  border-left: 3px solid var(--info);
}

.ucl-alert--success {
  border-left: 3px solid var(--success);
}

.ucl-alert--warning {
  border-left: 3px solid var(--warning);
}

.ucl-alert--error {
  border-left: 3px solid var(--error);
}

.ucl-table {
  width: 100%;
  min-width: 100%;
  border-collapse: collapse;
  border: 1px solid var(--border);
}

.ucl-table th,
.ucl-table td {
  padding: 0.75rem 1rem;
  font-size: 0.875rem;
  line-height: 1.4;
  text-align: left;
  border: 1px solid var(--border);
  vertical-align: middle;
}

.ucl-table th {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--muted-foreground);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background-color: color-mix(in srgb, var(--muted) 55%, transparent);
}

.ucl-table td {
  color: var(--foreground);
}

.ucl-table tbody tr:hover td {
  background-color: color-mix(in srgb, var(--muted) 50%, transparent);
}

.ucl-pagination-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2rem;
  min-height: 2rem;
  padding: 0.375rem 0.75rem;
  border-radius: var(--radius, 2px);
  border: 1px solid var(--border);
  background-color: var(--background);
  color: var(--foreground);
  font-size: 0.875rem;
  line-height: 1.25rem;
  cursor: pointer;
}

.ucl-pagination-btn:hover:not(:disabled) {
  background-color: var(--accent);
}

.ucl-pagination-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.ucl-pagination-btn--active {
  border-color: var(--primary);
  background-color: var(--primary);
  color: var(--primary-foreground);
}

.ucl-pagination-select {
  min-height: 2rem;
  padding: 0.375rem 0.625rem;
  border-radius: var(--radius, 2px);
  border: 1px solid var(--border);
  background-color: var(--background);
  color: var(--foreground);
  font-size: 0.875rem;
}

.ucl-dropdown-trigger {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  width: 100%;
  min-height: 2.25rem;
  padding: 0.5rem 1rem;
  border-radius: var(--radius, 2px);
  border: 1px solid var(--border);
  background-color: var(--background);
  color: var(--foreground);
  font-size: 0.875rem;
  cursor: pointer;
}

.ucl-dropdown-trigger:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.ucl-dropdown {
  position: relative;
  display: inline-block;
}

.ucl-dropdown-menu {
  margin-top: 0.25rem;
  padding: 0.25rem 0;
  border-radius: var(--radius, 2px);
  border: 1px solid var(--border);
  background-color: var(--popover);
  color: var(--popover-foreground);
  box-shadow: var(--shadow-md);
}

.ucl-dropdown-menu--positioned {
  position: absolute;
  z-index: 10;
  width: 100%;
  max-height: 15rem;
  overflow: auto;
}

/* Dropdown size modifiers */
.ucl-dropdown--sm .ucl-dropdown-trigger,
.ucl-dropdown--sm .ucl-dropdown-menu__item {
  font-size: 0.75rem;
  padding: 0.25rem 0.5rem;
}

.ucl-dropdown--md .ucl-dropdown-trigger,
.ucl-dropdown--md .ucl-dropdown-menu__item {
  font-size: 0.875rem;
  padding: 0.375rem 0.75rem;
}

.ucl-dropdown--lg .ucl-dropdown-trigger,
.ucl-dropdown--lg .ucl-dropdown-menu__item {
  font-size: 1rem;
  padding: 0.5rem 1rem;
}

.ucl-dropdown-trigger__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.25rem;
  height: 1.25rem;
  margin-left: 0.375rem;
}

.ucl-dropdown-menu__item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
  cursor: pointer;
}

.ucl-dropdown-menu__item:hover,
.ucl-dropdown-menu__item:focus {
  background-color: var(--accent);
  color: var(--foreground);
  outline: none;
}

.ucl-search-input {
  width: 100%;
  min-height: 2.25rem;
  padding: 0.5rem 2.25rem;
  border-radius: var(--radius, 2px);
  border: 1px solid var(--border);
  background-color: var(--background);
  color: var(--foreground);
  font-size: 0.875rem;
}

.ucl-search-input:focus {
  outline: none;
  border-color: var(--ring);
  box-shadow: 0 0 0 1px var(--ring);
}

.ucl-menu-item {
  display: block;
  width: 100%;
  padding: 0.5rem 0.75rem;
  font-size: 0.875rem;
  text-align: left;
  color: var(--foreground);
  background: transparent;
  border: 0;
  cursor: pointer;
}

.ucl-menu-item:hover {
  background-color: var(--accent);
}

.ucl-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 40;
  background-color: rgb(0 0 0 / 0.4);
  backdrop-filter: blur(1px);
}

.ucl-modal-content {
  position: fixed;
  left: 50%;
  top: 50%;
  z-index: 50;
  width: min(calc(100% - 2rem), 32rem);
  max-height: calc(100vh - 2rem);
  overflow: auto;
  transform: translate(-50%, -50%);
  background-color: var(--card);
  color: var(--card-foreground);
  border-radius: calc(var(--radius, 2px) + 2px);
  padding: 1.5rem;
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--border);
}

/* Modal size modifiers */
.ucl-modal-content--sm {
  width: min(calc(100% - 2rem), 22rem);
}

.ucl-modal-content--md {
  width: min(calc(100% - 2rem), 32rem);
}

.ucl-modal-content--lg {
  width: min(calc(100% - 2rem), 48rem);
}

.ucl-modal-content--full {
  width: calc(100% - 2rem);
  max-height: calc(100vh - 2rem);
}

.ucl-toast {
  position: fixed;
  right: 1.5rem;
  bottom: 1.5rem;
  z-index: 70;
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  max-width: 24rem;
  border-radius: var(--radius, 2px);
  background-color: var(--card);
  color: var(--foreground);
  padding: 0.75rem 1rem;
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--border);
}

.ucl-toast__body {
  flex: 1;
  font-size: 0.875rem;
  line-height: 1.4;
}

.ucl-toast__close {
  flex-shrink: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--muted-foreground);
  font-size: 1.125rem;
  line-height: 1;
  cursor: pointer;
}

.ucl-toast__close:hover {
  color: var(--foreground);
}

.ucl-toast--success {
  border-left: 3px solid var(--success);
}

.ucl-toast--warning {
  border-left: 3px solid var(--warning);
}

.ucl-toast--error {
  border-left: 3px solid var(--error);
}

.ucl-toast--info {
  border-left: 3px solid var(--info);
}

.ucl-pagination {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin-top: 1rem;
}

.ucl-pagination__controls {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 0.5rem;
}

.ucl-pagination__pages {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 0.25rem;
}

.ucl-kanban-board {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}

.ucl-kanban-card {
  padding: 0.75rem;
  border-radius: var(--radius, 2px);
  border: 1px solid var(--border);
  background-color: var(--card);
  color: var(--card-foreground);
}

.ucl-kanban-column {
  min-height: 10rem;
  padding: 0.75rem;
  border-radius: calc(var(--radius, 2px) + 2px);
  border: 1px solid var(--border);
  background-color: color-mix(in srgb, var(--muted) 40%, transparent);
}

.ucl-kanban-column--active {
  border-color: var(--primary);
  background-color: color-mix(in srgb, var(--primary) 10%, var(--muted));
}

.ucl-dropdown-menu__item--active {
  background-color: var(--primary);
  color: var(--primary-foreground);
}

.ucl-dropdown-menu__item--destructive {
  color: var(--error);
}

.ucl-dropdown-menu__item--destructive:hover,
.ucl-dropdown-menu__item--destructive:focus {
  background-color: color-mix(in srgb, var(--error) 10%, transparent);
  color: var(--error);
}

.ucl-dropdown-menu__item:disabled,
.ucl-dropdown-menu__item[aria-disabled='true'] {
  opacity: 0.5;
  pointer-events: none;
}

@media (max-width: 768px) {
  .ucl-kanban-board {
    grid-template-columns: 1fr;
  }
}

/* Form labels */
.ucl-field-label,
label:where(.ucl-field) {
  display: block;
  margin-bottom: 0.375rem;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--foreground);
}

.ucl-field-hint {
  margin-top: 0.25rem;
  font-size: 0.75rem;
  color: var(--muted-foreground);
}

/* Layout surfaces */
.ucl-layout-shell {
  min-height: 100vh;
  color: var(--foreground);
  background: var(--background);
}

.ucl-layout-header {
  padding: 1rem 1.5rem;
  border-bottom: 1px solid var(--border);
  background: var(--card);
}

.ucl-layout-sidebar {
  padding: 1rem;
  border-right: 1px solid var(--border);
  background: var(--card);
}

.ucl-layout-main {
  padding: 1rem 1.5rem;
  flex: 1;
}

.ucl-layout-auth {
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  background: var(--muted);
}

.ucl-auth-card {
  width: 100%;
  max-width: 28rem;
  padding: 1.5rem;
  border: 1px solid var(--border);
  border-radius: calc(var(--radius, 2px) + 2px);
  background: var(--card);
  color: var(--card-foreground);
  box-shadow: var(--shadow-sm);
}

.ucl-surface-panel {
  padding: 1rem 1.5rem;
  border: 1px solid var(--border);
  border-radius: calc(var(--radius, 2px) + 2px);
  background: var(--card);
  color: var(--card-foreground);
}

.ucl-stack-vertical {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.ucl-inline-cluster {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
}

/* Modal / drawer */
.ucl-modal-header,
.ucl-drawer-header {
  margin-bottom: 1rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--border);
}

.ucl-modal-title,
.ucl-drawer-title {
  margin: 0;
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--foreground);
}

.ucl-modal-description,
.ucl-drawer-description {
  margin: 0.25rem 0 0;
  font-size: 0.875rem;
  color: var(--muted-foreground);
}

.ucl-modal-body {
  padding: 0.25rem 0;
}

.ucl-modal-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.5rem;
  margin-top: 1.25rem;
}

.ucl-drawer-content {
  position: fixed;
  z-index: 50;
  padding: 1rem 1.25rem;
  background: var(--card);
  color: var(--card-foreground);
  box-shadow: var(--shadow-lg);
  outline: none;
}

.ucl-drawer-content--left {
  inset: 0 auto 0 0;
  width: 100%;
  max-width: 28rem;
  height: 100%;
}

.ucl-drawer-content--right {
  inset: 0 0 0 auto;
  width: 100%;
  max-width: 28rem;
  height: 100%;
}

.ucl-drawer-content--bottom {
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  max-height: 80vh;
  border-top-left-radius: calc(var(--radius, 2px) + 2px);
  border-top-right-radius: calc(var(--radius, 2px) + 2px);
}

/* Command palette */
.ucl-command-palette {
  position: fixed;
  top: 5rem;
  left: 50%;
  z-index: 50;
  width: min(calc(100% - 2rem), 36rem);
  padding: 0.5rem;
  transform: translateX(-50%);
  border-radius: calc(var(--radius, 2px) + 2px);
  background: var(--card);
  color: var(--card-foreground);
  box-shadow: var(--shadow-lg);
}

.ucl-command-palette__input {
  width: 100%;
  padding: 0.5rem 0.75rem;
  border: 0;
  border-bottom: 1px solid var(--border);
  background: transparent;
  color: var(--foreground);
  font-size: 0.875rem;
}

.ucl-command-palette__input:focus {
  outline: none;
}

.ucl-command-palette__list {
  max-height: 20rem;
  padding: 0.25rem;
  overflow: auto;
}

.ucl-command-palette__heading {
  padding: 0.25rem 0.75rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--muted-foreground);
  text-transform: uppercase;
}

.ucl-command-palette__item {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0.75rem;
  border: 0;
  border-radius: var(--radius, 2px);
  background: transparent;
  color: var(--foreground);
  font-size: 0.875rem;
  text-align: left;
  cursor: pointer;
}

.ucl-command-palette__item:hover,
.ucl-command-palette__item[aria-selected='true'] {
  background: var(--accent);
}

.ucl-command-palette__empty {
  padding: 0.5rem 0.75rem;
  font-size: 0.875rem;
  color: var(--muted-foreground);
}

/* Calendar / date picker */
.ucl-calendar-panel {
  padding: 1rem;
  border: 1px solid var(--border);
  border-radius: calc(var(--radius, 2px) + 2px);
  background: var(--card);
  color: var(--card-foreground);
}

.ucl-calendar-nav,
.ucl-date-picker__nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}

.ucl-calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.ucl-calendar-weekday {
  padding: 0.25rem;
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--muted-foreground);
  text-align: center;
}

.ucl-calendar-cell {
  min-height: 5rem;
  padding: 0.25rem;
  border: 1px solid var(--border);
  border-radius: var(--radius, 2px);
  background: var(--card);
}

.ucl-calendar-cell--outside {
  color: var(--muted-foreground);
  background: color-mix(in srgb, var(--muted) 50%, transparent);
}

.ucl-calendar-cell__day {
  padding: 0.125rem;
  font-size: 0.75rem;
  font-weight: 500;
}

.ucl-calendar-cell__event {
  margin-top: 0.25rem;
  padding: 0.125rem 0.25rem;
  border-radius: var(--radius, 2px);
  background: color-mix(in srgb, var(--primary) 12%, transparent);
  color: var(--primary);
  font-size: 0.625rem;
}

.ucl-date-picker {
  margin: 0;
  padding: 0;
  border: 0;
}

.ucl-date-picker__table {
  width: 100%;
  border-collapse: collapse;
}

.ucl-date-picker__table th,
.ucl-date-picker__table td {
  padding: 0.5rem;
  font-size: 0.875rem;
  text-align: center;
}

.ucl-date-picker__day {
  padding: 0.375rem;
  border-radius: var(--radius, 2px);
  cursor: pointer;
}

.ucl-date-picker__day:hover {
  background: var(--accent);
}

.ucl-date-picker__day--outside {
  color: var(--muted-foreground);
}

.ucl-date-picker__day--selected {
  background: var(--primary);
  color: var(--primary-foreground);
}

.ucl-date-picker__day--disabled {
  opacity: 0.35;
  pointer-events: none;
  cursor: not-allowed;
}

.ucl-date-picker__day:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 1px;
}

/* Accordion / tabs */
.ucl-accordion-item {
  border-bottom: 1px solid var(--border);
}

.ucl-accordion-trigger {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 0;
  border: 0;
  background: transparent;
  color: var(--foreground);
  font-size: 0.875rem;
  font-weight: 500;
  text-align: left;
  cursor: pointer;
}

.ucl-accordion-content {
  padding-bottom: 0.75rem;
  color: var(--muted-foreground);
  font-size: 0.875rem;
}

.ucl-tabs-list {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.25rem;
  border-radius: var(--radius, 2px);
  background: var(--muted);
}

.ucl-tabs-trigger {
  padding: 0.375rem 0.75rem;
  border: 0;
  border-radius: var(--radius, 2px);
  background: transparent;
  color: var(--muted-foreground);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
}

.ucl-tabs-trigger[data-state='active'] {
  background: var(--card);
  color: var(--foreground);
  box-shadow: var(--shadow-sm);
}

.ucl-tabs-content {
  margin-top: 1rem;
  padding: 0.25rem 0;
}

/* Dialog */
.ucl-dialog-overlay {
  position: fixed;
  inset: 0;
  z-index: 40;
  background-color: rgb(0 0 0 / 0.4);
  backdrop-filter: blur(1px);
}

.ucl-dialog-content {
  position: fixed;
  left: 50%;
  top: 50%;
  z-index: 50;
  width: min(calc(100% - 2rem), 32rem);
  max-height: calc(100vh - 2rem);
  overflow: auto;
  transform: translate(-50%, -50%);
  background-color: var(--card);
  color: var(--card-foreground);
  border-radius: calc(var(--radius, 2px) + 2px);
  padding: 1.5rem;
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--border);
}

.ucl-dialog-trigger {
  cursor: pointer;
}

/* Sidebar */
.ucl-sidebar {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 25rem;
  border-right: 1px solid var(--border);
  background: var(--card);
  color: var(--card-foreground);
}

.ucl-sidebar--collapsed {
  width: 5rem;
}

.ucl-sidebar--expanded {
  width: 18rem;
}

.ucl-sidebar__toolbar {
  display: flex;
  justify-content: flex-end;
  padding: 0.5rem;
}

.ucl-sidebar__nav {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 1rem;
  padding: 0.75rem;
}

.ucl-sidebar__group-label {
  margin-bottom: 0.25rem;
  padding: 0 0.5rem;
  color: var(--muted-foreground);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.ucl-sidebar__item {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem;
  border: 0;
  border-radius: var(--radius, 2px);
  background: transparent;
  color: var(--foreground);
  font-size: 0.875rem;
  text-align: left;
  cursor: pointer;
}

.ucl-sidebar__item:hover {
  background: var(--accent);
}

.ucl-sidebar__item--active {
  background: color-mix(in srgb, var(--primary) 12%, transparent);
  color: var(--primary);
}

.ucl-sidebar__badge {
  padding: 0.125rem 0.5rem;
  border-radius: 9999px;
  background: var(--muted);
  font-size: 0.75rem;
}

/* Empty / popover / tooltip */
.ucl-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  border: 1px dashed var(--border);
  border-radius: calc(var(--radius, 2px) + 2px);
  background: color-mix(in srgb, var(--muted) 45%, transparent);
  text-align: center;
}

.ucl-empty-state__icon {
  margin-bottom: 0.75rem;
  color: var(--muted-foreground);
}

.ucl-empty-state__title {
  margin: 0;
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--foreground);
}

.ucl-empty-state__description {
  margin: 0.5rem 0 0;
  font-size: 0.875rem;
  color: var(--muted-foreground);
}

.ucl-empty-state__action {
  margin-top: 1rem;
}

.ucl-popover {
  z-index: 50;
  padding: 0.75rem;
  border: 1px solid var(--border);
  border-radius: calc(var(--radius, 2px) + 2px);
  background: var(--popover);
  color: var(--popover-foreground);
  box-shadow: var(--shadow-md);
}

/* Popover size modifiers */
.ucl-popover--sm {
  padding: 0.5rem;
  min-width: 10rem;
}

.ucl-popover--md {
  padding: 0.75rem;
  min-width: 14rem;
}

.ucl-popover--lg {
  padding: 1rem;
  min-width: 20rem;
}

.ucl-tooltip-trigger {
  position: relative;
  display: inline-block;
}

.ucl-tooltip-bubble {
  position: absolute;
  z-index: 50;
  display: none;
  padding: 0.25rem 0.5rem;
  border-radius: var(--radius, 2px);
  background: var(--foreground);
  color: var(--background);
  font-size: 0.75rem;
  white-space: nowrap;
  pointer-events: none;
}

/* Side positioning — default is top */
.ucl-tooltip-bubble,
.ucl-tooltip-bubble--top {
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-bottom: 0.375rem;
}

.ucl-tooltip-bubble--bottom {
  top: 100%;
  bottom: auto;
  left: 50%;
  transform: translateX(-50%);
  margin-top: 0.375rem;
  margin-bottom: 0;
}

.ucl-tooltip-bubble--left {
  right: 100%;
  bottom: auto;
  left: auto;
  top: 50%;
  transform: translateY(-50%);
  margin-right: 0.375rem;
  margin-bottom: 0;
}

.ucl-tooltip-bubble--right {
  left: 100%;
  bottom: auto;
  top: 50%;
  transform: translateY(-50%);
  margin-left: 0.375rem;
  margin-bottom: 0;
}

.ucl-tooltip-trigger:hover .ucl-tooltip-bubble,
.ucl-tooltip-trigger:focus-within .ucl-tooltip-bubble {
  display: block;
  transition-delay: var(--tooltip-delay, 0ms);
}

/* Form controls */
.ucl-control-field {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
}

.ucl-control-field--switch {
  gap: 0.75rem;
}

.ucl-control-stack {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 0.25rem;
}

.ucl-checkbox-box {
  width: 1.25rem;
  height: 1.25rem;
  appearance: none;
  border: 1px solid var(--input);
  border-radius: var(--radius, 2px);
  background: var(--background);
  cursor: pointer;
}

.ucl-checkbox-box:checked {
  border-color: var(--primary);
  background: var(--primary);
}

.ucl-checkbox-box--sm {
  width: 1rem;
  height: 1rem;
}

.ucl-checkbox-box--lg {
  width: 1.5rem;
  height: 1.5rem;
}

.ucl-checkbox-box + svg {
  position: absolute;
  inset: 0;
  margin: auto;
  color: var(--primary-foreground);
  opacity: 0;
  pointer-events: none;
}

.ucl-checkbox-box:checked + svg {
  opacity: 1;
}

.ucl-radio-input {
  width: 1rem;
  height: 1rem;
  margin-top: 0.125rem;
  accent-color: var(--primary);
}

.ucl-switch {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  padding: 2px;
  border: 2px solid transparent;
  border-radius: 9999px;
  background: var(--border);
  cursor: pointer;
}

.ucl-switch[data-state='checked'] {
  background: var(--primary);
}

.ucl-switch--sm {
  width: 1.75rem;
  height: 1rem;
}

.ucl-switch--md {
  width: 2.25rem;
  height: 1.25rem;
}

.ucl-switch--lg {
  width: 2.75rem;
  height: 1.5rem;
}

.ucl-switch-thumb {
  display: block;
  border-radius: 9999px;
  background: var(--card);
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease;
}

.ucl-switch--sm .ucl-switch-thumb {
  width: 0.75rem;
  height: 0.75rem;
}

.ucl-switch--md .ucl-switch-thumb {
  width: 1rem;
  height: 1rem;
}

.ucl-switch--lg .ucl-switch-thumb {
  width: 1.25rem;
  height: 1.25rem;
}

.ucl-switch[data-state='checked'] .ucl-switch-thumb {
  transform: translateX(100%);
}

/* Progress / text / link */
.ucl-progress {
  width: 100%;
  height: 0.5rem;
  overflow: hidden;
  border-radius: 9999px;
  background: var(--muted);
}

.ucl-progress__bar {
  height: 100%;
  background: var(--primary);
  transition: width 0.2s ease;
}

.ucl-text {
  margin: 0;
  color: var(--foreground);
}

.ucl-text--xs {
  font-size: var(--text-xs, 0.75rem);
}

.ucl-text--sm {
  font-size: var(--text-sm, 0.875rem);
}

.ucl-text--lg {
  font-size: var(--text-lg, 1.125rem);
}

.ucl-text--xl {
  font-size: var(--text-xl, 1.25rem);
}

.ucl-link {
  color: var(--primary);
  text-decoration: underline;
}

.ucl-link--subtle {
  color: var(--muted-foreground);
}

.ucl-code {
  display: inline-block;
  padding: 0.125rem 0.375rem;
  border-radius: var(--radius, 2px);
  background: var(--muted);
  color: var(--foreground);
  font-family: var(--font-mono);
  font-size: 0.875em;
}

.ucl-kbd {
  display: inline-block;
  padding: 0.125rem 0.375rem;
  border: 1px solid var(--border);
  border-radius: var(--radius, 2px);
  background: var(--card);
  font-family: var(--font-mono);
  font-size: 0.75rem;
}

.ucl-avatar {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 9999px;
  background: var(--muted);
  color: var(--foreground);
}

.ucl-avatar--sm {
  width: 1.5rem;
  height: 1.5rem;
}

.ucl-avatar--md {
  width: 2.5rem;
  height: 2.5rem;
}

.ucl-avatar--lg {
  width: 4rem;
  height: 4rem;
}

.ucl-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ucl-skeleton {
  border-radius: var(--radius, 2px);
  background: var(--muted);
}

.ucl-divider {
  margin: 1rem 0;
  border: 0;
  border-top: 1px solid var(--border);
}

/* Breadcrumb / stepper / timeline / tree */
.ucl-breadcrumb {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  color: var(--muted-foreground);
}

.ucl-breadcrumb__link {
  padding: 0.125rem 0;
  color: inherit;
  text-decoration: none;
}

.ucl-breadcrumb__link:hover {
  color: var(--foreground);
}

.ucl-breadcrumb__current {
  font-weight: 600;
  color: var(--foreground);
}

.ucl-stepper {
  display: flex;
  gap: 0.75rem;
}

.ucl-stepper--vertical {
  flex-direction: column;
}

.ucl-stepper__step {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  padding: 0.25rem;
  border: 0;
  background: transparent;
  text-align: left;
  cursor: pointer;
}

.ucl-stepper__step:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.ucl-stepper__indicator {
  display: inline-flex;
  width: 1.75rem;
  height: 1.75rem;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
}

.ucl-stepper__indicator--active {
  border-color: var(--primary);
  background: var(--primary);
  color: var(--primary-foreground);
}

.ucl-stepper__indicator--done {
  border-color: var(--success);
  background: var(--success);
  color: var(--success-foreground);
}

.ucl-timeline {
  margin: 0;
  padding: 0;
  list-style: none;
}

.ucl-timeline__item {
  display: flex;
  gap: 0.75rem;
  padding-left: 0.25rem;
}

.ucl-timeline__marker {
  display: inline-flex;
  width: 1rem;
  height: 1rem;
  align-items: center;
  justify-content: center;
  margin-top: 0.25rem;
  border-radius: 9999px;
  background: var(--primary);
  color: var(--primary-foreground);
  font-size: 0.625rem;
}

.ucl-timeline__body {
  padding-bottom: 0.75rem;
}

.ucl-timeline__title {
  margin: 0;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--foreground);
}

.ucl-timeline__description,
.ucl-timeline__timestamp {
  margin: 0.25rem 0 0;
  font-size: 0.875rem;
  color: var(--muted-foreground);
}

.ucl-tree-view {
  margin: 0;
  padding: 0;
  list-style: none;
}

.ucl-tree-view__row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.ucl-tree-view__toggle {
  width: 1.25rem;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--muted-foreground);
  cursor: pointer;
}

.ucl-tree-view__node {
  padding: 0.125rem 0.375rem;
  border: 0;
  border-radius: var(--radius, 2px);
  background: transparent;
  color: var(--foreground);
  font-size: 0.875rem;
  cursor: pointer;
}

.ucl-tree-view__node:hover {
  background: var(--accent);
}

/* File upload / OTP / slider / rating */
.ucl-file-upload-zone {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2rem 1rem;
  border: 1px dashed var(--border);
  border-radius: var(--radius, 2px);
  background: color-mix(in srgb, var(--muted) 40%, transparent);
  text-align: center;
  cursor: pointer;
}

.ucl-file-upload-zone--active {
  border-color: var(--primary);
  background: color-mix(in srgb, var(--primary) 8%, transparent);
}

.ucl-file-upload-list__item {
  padding: 0.25rem 0.5rem;
  border: 1px solid var(--border);
  border-radius: var(--radius, 2px);
  font-size: 0.875rem;
}

.ucl-otp-input {
  display: flex;
  gap: 0.5rem;
}

.ucl-otp-input__slot {
  width: 2.5rem;
  height: 2.5rem;
  padding: 0.25rem;
  border: 1px solid var(--border);
  border-radius: var(--radius, 2px);
  background: var(--background);
  color: var(--foreground);
  font-size: 1.125rem;
  text-align: center;
}

.ucl-slider {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: 1.25rem;
  padding: 0.25rem 0;
}

.ucl-slider__track {
  position: relative;
  width: 100%;
  height: 0.25rem;
  border-radius: 9999px;
  background: var(--muted);
}

.ucl-slider__range {
  position: absolute;
  height: 100%;
  border-radius: 9999px;
  background: var(--primary);
}

.ucl-slider__thumb {
  display: block;
  width: 1rem;
  height: 1rem;
  border: 1px solid var(--primary);
  border-radius: 9999px;
  background: var(--card);
  box-shadow: var(--shadow-sm);
}

.ucl-rating {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.ucl-rating__button {
  padding: 0.125rem;
  border: 0;
  background: transparent;
  cursor: pointer;
}

.ucl-color-picker__input {
  width: 2.5rem;
  height: 2.5rem;
  padding: 0.125rem;
  border: 1px solid var(--border);
  border-radius: var(--radius, 2px);
  background: var(--background);
}

.ucl-kanban-column__title {
  margin: 0 0 0.75rem;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--foreground);
}

.ucl-kanban-column__cards {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.ucl-kanban-card__title {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--foreground);
}

.ucl-kanban-card:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 1px;
}

.ucl-kanban-card[aria-grabbed='true'] {
  opacity: 0.6;
}

.ucl-pagination-meta {
  padding: 0.25rem 0;
  font-size: 0.875rem;
  color: var(--muted-foreground);
}

.ucl-pagination-ellipsis {
  padding: 0 0.5rem;
  color: var(--muted-foreground);
}

.ucl-form-stack {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.ucl-hidden {
  display: none !important;
}
