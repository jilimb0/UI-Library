  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.json --emitDeclarationOnly --declarationMap && node scripts/generate-subpath-entries.js",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "test": "vitest run --config ./vitest.config.ts src",
    "test:watch": "vitest --config ./vitest.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "dependencies": {
    "@ui-construction-library/behaviors": "workspace:*",
