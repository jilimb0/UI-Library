{
  "name": "@ui-construction-library/core",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Modern React UI component library",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./styles": "./dist/styles.css"
  },
  "scripts": {
    "build": "rollup -c",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "test": "vitest run --config ./vitest.config.ts src",
    "test:watch": "vitest --config ./vitest.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "dependencies": {
    "@ui-construction-library/dnd": "^0.1.1",
    "@ui-construction-library/icons": "^0.1.1",
    "@ui-construction-library/motion": "^0.1.1",
    "@ui-construction-library/primitives": "^0.1.0",
    "@ui-construction-library/tokens": "^0.1.1",
    "@ui-construction-library/utils": "^0.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "happy-dom": "^20.8.9",
    "jest-axe": "^10.0.0",
    "rollup": "^4.34.8",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  },
  "license": "MIT",
  "type": "module"
}
