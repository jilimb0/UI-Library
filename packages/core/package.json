{
  "name": "@ui/core",
  "version": "0.1.5",
  "description": "Enterprise React UI component library",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc --build && vite build",
    "dev": "vite build --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts src",
    "test:animations": "vitest run --config ../../vitest.config.ts src/animations",
    "test:atoms": "vitest run --config ../../vitest.config.ts src/components/atoms",
    "test:molecules": "vitest run --config ../../vitest.config.ts src/components/molecules",
    "test:organisms": "vitest run --config ../../vitest.config.ts src/components/organisms",
    "test:hooks": "vitest run --config ../../vitest.config.ts src/hooks",
    "test:utils": "vitest run --config ../../vitest.config.ts src/utils",
    "test:watch": "vitest --config ../../vitest.config.ts -- --watch",
    "test:coverage": "vitest run --config ../../vitest.config.ts -- --coverage",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "typescript",
    "tailwind"
  ],
  "author": "UI Library Team",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "framer-motion": "^10.16.0",
    "lucide-react": "^0.292.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.8",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.50.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.0.0",
    "vite": "^4.5.0",
    "vite-plugin-dts": "^3.9.1"
  }
}
