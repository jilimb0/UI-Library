{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ui/tokens": ["../tokens/src"],
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.*", "src/**/*.stories.*", "dist"]
}
