{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "paths": {
      "@/*": ["./src/*"],
      "@ui-lib/tokens": ["../tokens/src/index.ts"],
      "@ui-lib/icons": ["../icons/src/index.ts"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*",
    "../../public/icons",
    "vitest-env.d.ts",
    "**/*.test.tsx",
    "**/*.spec.tsx"
  ],
  "exclude": ["src/**/*.test.*", "src/**/*.stories.*", "dist"]
}
