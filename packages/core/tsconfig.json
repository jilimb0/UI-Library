{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ui/tokens": ["../tokens/src"]
    },
    "types": []
  },
  "include": [
    "src/**/*",
    "../../public/icons",
    "vitest-env.d.ts",
    "**/*.test.tsx",
    "**/*.spec.tsx"
  ],
  "exclude": ["src/**/*.test.*", "src/**/*.stories.*", "dist"]
}
