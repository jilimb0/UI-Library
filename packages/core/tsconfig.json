{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "../..",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "allowArbitraryExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "vitest-env.d.ts",
    "src/styles/global-css.d.ts",
    "src/styles/*.css.d.ts",
    "**/*.test.tsx",
    "**/*.spec.tsx"
  ],
  "exclude": ["src/**/*.test.*", "src/**/*.stories.*", "dist"]
}
