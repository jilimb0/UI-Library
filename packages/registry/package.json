{
  "name": "@ui-construction-library/registry",
  "version": "0.3.0",
  "description": "Internal component registry for @ui-construction-library tooling \u2014 not for direct consumer use.",
  "keywords": [
    "internal",
    "tooling"
  ],
  "ui-construction": {
    "surface": "internal",
    "mode": "platform"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jilimb0/UI-Library"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.json --emitDeclarationOnly --declarationMap",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.34.8",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.esm.js"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}