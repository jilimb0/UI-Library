{
  "name": "@ui-construction-library/schema",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jilimb0/UI-Library"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.build.json --emitDeclarationOnly --declarationMap",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.34.8",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  },
  "description": "Internal schema definitions for @ui-construction-library tooling — not for direct consumer use.",
  "ui-construction": {
    "surface": "internal",
    "mode": "platform"
  },
  "keywords": [
    "internal",
    "tooling"
  ]
}
