{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-construction-library.dev/schemas/component.schema.json",
  "title": "ComponentMetadata",
  "type": "object",
  "required": ["id", "slug", "displayName", "package", "version", "category", "props"],
  "properties": {
    "id":          { "type": "string", "minLength": 1 },
    "slug":        { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "package":     { "type": "string", "minLength": 1 },
    "version":     { "type": "string", "minLength": 1 },
    "category":    { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["stable", "beta", "experimental", "deprecated"]
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name":         { "type": "string", "minLength": 1 },
          "type":         { "type": "string", "minLength": 1 },
          "required":     { "type": "boolean" },
          "description":  { "type": "string" },
          "defaultValue": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "slots":  { "type": "array", "items": { "type": "string" } },
    "events": { "type": "array", "items": { "type": "string" } },
    "states": { "type": "array", "items": { "type": "string" } },
    "a11y": {
      "type": "object",
      "properties": {
        "role":                 { "type": "string" },
        "ariaRequired":        { "type": "array", "items": { "type": "string" } },
        "keyboard":            { "type": "array", "items": { "type": "string" } },
        "focusBehavior":       { "type": "string" },
        "screenReaderNotes":   { "type": "array", "items": { "type": "string" } },
        "invalidCombinations": { "type": "array", "items": { "type": "string" } },
        "localizationNotes":   { "type": "array", "items": { "type": "string" } }
      },
      "required": ["keyboard", "screenReaderNotes"],
      "additionalProperties": false
    },
    "responsiveBehavior": { "type": "array", "items": { "type": "string" } },
    "styleHooks":         { "type": "array", "items": { "type": "string" } },
    "builder": {
      "type": "object",
      "required": ["editingSurface", "allowChildren"],
      "properties": {
        "editingSurface": {
          "type": "string",
          "enum": [
            "inline-editable",
            "prop-driven",
            "data-bound",
            "layout-container",
            "section-block",
            "overlay",
            "advanced"
          ]
        },
        "allowChildren": { "type": "boolean" },
        "insertionRules": {
          "type": "object",
          "properties": {
            "allowedParentIds":       { "type": "array", "items": { "type": "string" } },
            "blockedParentIds":       { "type": "array", "items": { "type": "string" } },
            "blockedInsideInteractive": { "type": "boolean" },
            "requiresSelectedParent": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "description", "requiredProps", "recommendedDefaults"],
        "properties": {
          "id":                  { "type": "string", "minLength": 1 },
          "label":               { "type": "string", "minLength": 1 },
          "description":         { "type": "string" },
          "requiredProps":       { "type": "array", "items": { "type": "string" } },
          "recommendedDefaults": { "type": "object" },
          "a11yCaveats":         { "type": "array", "items": { "type": "string" } },
          "doExample":           { "type": "string" },
          "dontExample":         { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "antiPatterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "reason"],
        "properties": {
          "id":          { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "reason":      { "type": "string" },
          "fix":         { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "export": {
      "type": "object",
      "required": ["react", "next"],
      "properties": {
        "react": { "type": "string", "enum": ["supported", "partial", "unsupported"] },
        "next":  { "type": "string", "enum": ["supported", "partial", "unsupported"] }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": ["react", "next", "static", "webComponents", "vue", "angular"],
      "properties": {
        "react":         { "type": "boolean" },
        "next":          { "type": "boolean" },
        "static":        { "type": "boolean" },
        "webComponents": { "type": "boolean" },
        "vue":           { "type": "boolean" },
        "angular":       { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
