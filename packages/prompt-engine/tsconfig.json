{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false,
    "noEmit": false,
    "ignoreDeprecations": "6.0",
    "types": ["vitest/globals"],
    "paths": {
      "@ui-construction-library/schema": ["../schema/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../schema" }]
}
