{
  "name": "@ui-construction-library/prompt-engine",
  "version": "0.1.2",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@ui-construction-library/registry": "workspace:*",
    "@ui-construction-library/schema": "workspace:*"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.34.8",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  },
  "description": "Internal AI prompt generation engine for @ui-construction-library tooling — not for direct consumer use.",
  "keywords": [
    "prompt",
    "ai",
    "internal",
    "tooling",
    "design-system"
  ]
}
