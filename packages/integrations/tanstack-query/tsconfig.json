{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@ui-construction-library/core": ["../../core/src/index.ts"],
      "@ui-construction-library/tokens": ["../../tokens/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../../core" },
    { "path": "../../tokens" }
  ]
}
