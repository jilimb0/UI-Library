{
  "name": "@ui-construction-library/export-core",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./targets": {
      "import": "./dist/targets.js",
      "require": "./dist/targets.js",
      "types": "./dist/targets.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@ui-construction-library/registry": "workspace:*",
    "@ui-construction-library/schema": "workspace:*",
    "@ui-construction-library/styles": "workspace:*",
    "@ui-construction-library/tokens": "workspace:*"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.34.8",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  }
}
