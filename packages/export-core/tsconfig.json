{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false,
    "noEmit": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../schema" },
    { "path": "../registry" },
    { "path": "../tokens" },
    { "path": "../styles" }
  ]
}
