{
  "name": "ui-library-monorepo",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "24.11.0",
    "pnpm": "11.7.0"
  },
  "workspaces": [
    "packages/*",
    "packages/integrations/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:ci": "turbo run build --force",
    "clean": "bash clean.sh",
    "dev": "turbo run dev",
    "test": "bash scripts/core/test.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "check:deps": "./scripts/checks/check-dependency-boundaries.sh && ./scripts/checks/check-app-dependency-policy.sh",
    "check:boundaries": "node ./scripts/checks/check-package-boundaries.mjs",
    "check:public-surface": "node ./scripts/checks/check-public-surface.mjs",
    "check:api": "./scripts/checks/check-api-snapshot.sh",
    "update:api": "node scripts/checks/generate-api-snapshot.mjs > packages/core/api-snapshot.json",
    "check:published": "node ./scripts/checks/check-published-versions.js",
    "check:published:code": "node ./scripts/checks/check-published-code.js",
    "check:bundle": "node ./scripts/checks/check-bundle-size.js",
    "check:contracts": "./scripts/checks/check-contract-compliance.sh",
    "playwright:install": "playwright install chromium",
    "check:e2e": "pnpm playwright:install && playwright test",
    "check:security": "pnpm audit --audit-level=high",
    "check:hygiene": "node ./scripts/checks/check-repo-hygiene.js",
    "check:workspace-scripts": "node ./scripts/checks/check-workspace-scripts.js",
    "check:perf": "pnpm exec vitest run --config tests/performance/vitest.config.js",
    "check:surface-tests": "pnpm exec vitest run --config tests/surface/vitest.config.mjs",
    "publish:canary": "./scripts/ci/publish-canary.sh",
    "publish:stable": "./scripts/ci/publish-stable.sh",
    "changelog:packages": "node ./scripts/generators/generate-package-changelogs.js",
    "release:prepare": "./scripts/ci/prepare-release.sh",
    "release:prepare:patch": "./scripts/ci/prepare-release.sh --bump=patch",
    "release:prepare:minor": "./scripts/ci/prepare-release.sh --bump=minor",
    "release:prepare:major": "./scripts/ci/prepare-release.sh --bump=major",
    "version:bump": "node ./scripts/checks/check-published-code.js --json | node ./scripts/utils/bump-package-versions.js",
    "version:bump:dry": "node ./scripts/checks/check-published-code.js --json | node ./scripts/utils/bump-package-versions.js --dry-run",
    "storybook": "turbo run storybook",
    "build-storybook": "pnpm --filter @ui-app/storybook build-storybook",
    "demo:dev": "pnpm --filter @ui-app/demo-showcase dev",
    "demo:build": "pnpm --filter @ui-app/demo-showcase build",
    "demo:preview": "pnpm --filter @ui-app/demo-showcase preview",
    "demo:typecheck": "pnpm --filter @ui-app/demo-showcase typecheck",
    "release:preflight": "./scripts/ci/release-preflight.sh",
    "upgrade:doctor": "node ./scripts/utils/upgrade-doctor.js",
    "registry:source:check": "node ./scripts/checks/check-source-registry.js",
    "preset:bootstrap": "node ./scripts/utils/bootstrap-preset.js",
    "preset:check": "node ./scripts/checks/check-preset-docs.js",
    "check:gold-kits": "node ./scripts/checks/check-gold-kits.js",
    "check:launch": "node ./scripts/checks/check-launch-readiness.js",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "sync-versions": "node scripts/utils/sync-app-versions.js",
    "sync-versions:dry": "node scripts/utils/sync-app-versions.js --dry-run",
    "release": "turbo run build && changeset publish",
    "validate": "bash scripts/run-local-ci.sh --no-platform",
    "validate:platform": "bash scripts/run-local-ci.sh",
    "prepare": "husky",
    "check:supabase-schema": "node ./scripts/checks/check-supabase-schema-skeleton.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,jsonc,css,md,yml,yaml}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "^2.27.0",
    "@playwright/test": "^1.58.2",
    "@storybook/react": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@vitejs/plugin-react": "^5.2.0",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "lint-staged": "^17.0.4",
    "resolve": "1.22.12",
    "serve": "^14.2.4",
    "storybook": "^10.4.0",
    "tsx": "^4.8.1",
    "turbo": "^2.9.14",
    "typescript": "^5.6.3",
    "vitest": "catalog:"
  }
}
