{
  "name": "ui-library-monorepo",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "22.15.0",
    "pnpm": "11.1.2"
  },
  "workspaces": [
    "packages/*",
    "packages/integrations/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "check:deps": "./scripts/check-dependency-boundaries.sh",
    "storybook": "turbo run storybook",
    "build-storybook": "pnpm --filter @ui-app/storybook build-storybook",
    "demo:dev": "pnpm --filter @ui-app/demo-showcase dev",
    "demo:build": "pnpm --filter @ui-app/demo-showcase build",
    "demo:preview": "pnpm --filter @ui-app/demo-showcase preview",
    "demo:typecheck": "pnpm --filter @ui-app/demo-showcase typecheck",
    "release:preflight": "./scripts/release-preflight.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "sync-versions": "node scripts/sync-app-versions.js",
    "sync-versions:dry": "node scripts/sync-app-versions.js --dry-run",
    "release": "turbo run build && changeset publish",
    "validate": "pnpm check:deps && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,jsonc,css,md,yml,yaml}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "overrides": {
      "happy-dom": ">=20.8.9",
      "esbuild": "^0.25.0",
      "vite": "^8.0.0",
      "postcss": ">=8.5.10",
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "@types/react": "^18.3.27",
      "@types/react-dom": "^18.3.7"
    },
    "packageExtensions": {
      "@storybook/builder-vite@*": {
        "peerDependencies": {
          "vite": "^8.0.0"
        }
      },
      "@storybook/react-vite@*": {
        "peerDependencies": {
          "vite": "^8.0.0"
        }
      },
      "next@*": {
        "dependencies": {
          "postcss": ">=8.5.10"
        }
      }
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "^2.27.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "turbo": "^2.9.14",
    "typescript": "^5.6.3",
    "vitest": "catalog:"
  }
}
