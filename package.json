{
  "name": "ui-library-monorepo",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "workspaces": [
    "packages/*",
    "packages/integrations/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "storybook": "turbo run storybook",
    "build-storybook": "pnpm --filter @ui-lib/storybook build-storybook",
    "demo:dev": "pnpm --filter @ui/demo-showcase dev",
    "demo:build": "pnpm --filter @ui/demo-showcase build",
    "demo:preview": "pnpm --filter @ui/demo-showcase preview",
    "demo:typecheck": "pnpm --filter @ui/demo-showcase typecheck",
    "release:preflight": "./scripts/release-preflight.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@storybook/react-vite": "^10.4.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jest-axe": "^10.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "rollup": "^4.34.8",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "tailwindcss": "^4.3.0",
    "ts-jest": "^29.4.9",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  }
}
