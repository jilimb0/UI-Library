{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ui-construction-library/core": ["../../packages/core/src/index.ts"],
      "@ui-construction-library/core/*": ["../../packages/core/src/*"],
      "@ui-construction-library/icons": ["../../packages/icons/src/index.ts"],
      "@ui-construction-library/tokens": ["../../packages/tokens/src/index.ts"],
      "@ui-construction-library/utils": ["../../packages/utils/src/index.ts"],
      "@ui-construction-library/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.*"]
}
