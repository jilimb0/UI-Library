{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {},
    "types": [
      "react",
      "react-dom",
      "node"
    ]
  },
  "include": [
    "stories/**/*",
    ".storybook/**/*"
  ],
  "exclude": [
    "storybook-static",
    "node_modules",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
