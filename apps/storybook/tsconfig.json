{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@ui-construction-library/core": ["../../packages/core/src/index.ts"],
      "@ui-construction-library/core/*": ["../../packages/core/src/*"],
      "@ui-construction-library/dnd": ["../../packages/dnd/src/index.tsx"],
      "@ui-construction-library/icons": ["../../packages/icons/src/index.ts"],
      "@ui-construction-library/motion": [
        "../../packages/motion/src/index.ts"
      ],
      "@ui-construction-library/primitives": [
        "../../packages/primitives/src/index.ts"
      ],
      "@ui-construction-library/tokens": [
        "../../packages/tokens/src/index.ts"
      ],
      "@ui-construction-library/utils": ["../../packages/utils/src/index.ts"]
    },
    "types": [
      "react",
      "react-dom",
      "node"
    ]
  },
  "include": [
    "stories/**/*",
    ".storybook/**/*"
  ],
  "exclude": [
    "storybook-static",
    "node_modules",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
